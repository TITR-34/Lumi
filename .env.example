# Free key: https://aistudio.google.com/apikey  (never commit the real .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest,gemini-3.1-flash-lite
# Optional 2nd provider (free key at console.groq.com) used if Gemini fails or is rate-limited:
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
PORT=3000
# Dish photos -> Supabase Storage (Dashboard > Storage > New bucket "dish-images", set PUBLIC).
# Use the SECRET / service_role key (server only - never commit, never put in public/ files):
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=dish-images
